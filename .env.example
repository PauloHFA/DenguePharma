# Copie para .env e preencha. Nunca versionar o .env.
DB_NAME=denguepharma
DB_USER=denguepharma
DB_PASSWORD=
DB_PORT=5434
DB_URL=jdbc:postgresql://localhost:5434/denguepharma
RABBITMQ_USER=denguepharma
RABBITMQ_PASSWORD=
MINIO_USER=denguepharma
MINIO_PASSWORD=

# Backend
JWT_SECRET=            # mínimo 32 caracteres
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Fontes (opcionais): chave do NCBI aumenta a quota; e-mail identifica o cliente nas chamadas
NCBI_API_KEY=
NCBI_CONTACT_EMAIL=

# Pipeline: segredo distinto do JWT, ao menos 32 caracteres. Mesmo valor no backend e no worker.
PIPELINE_TOKEN=
BACKEND_URL=http://localhost:8080
PIPELINE_BACKEND_URL=http://host.docker.internal:8080
# Opcionais para executar a API em outra porta (ajustar os tres enderecos juntos).
SERVER_PORT=8080
DENGUEPHARMA_API_TARGET=http://localhost:8080
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
MINIO_ENDPOINT=localhost:9000
MINIO_SECURE=false

# Nova fundacao Analytics (opcional; nao altera as portas do legado).
ANALYTICS_API_URL=http://127.0.0.1:18081
ANALYTICS_DATA_DIR=analytics/data
LEGACY_CURATOR_URL=http://127.0.0.1:5173/curadoria
